{
  "extends": "@burdenoff/toolchain/tsconfig/node-lib.json",
  "compilerOptions": {
    // Incremental type-check cache: `tsc --noEmit`/`tsc` reuse prior
    // results instead of a cold full check each run (CPU/RAM saving).
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["bun"],
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": false,
    "noEmit": true
  },
  "include": ["./src/**/*", "./tests/**/*"],
  "exclude": ["./node_modules", "./dist", "./coverage"]
}
